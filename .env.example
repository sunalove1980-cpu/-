# Gemini API 연결용 환경 변수 예시 파일입니다.
# 실제 값은 이 파일을 복사한 .env.local 에 넣으세요. (.env.local 은 git에 올라가지 않습니다)
#
# 1) https://aistudio.google.com/apikey 에서 API 키를 발급받습니다.
# 2) 아래처럼 .env.local 파일을 만들고 키를 채워 넣습니다.
#
#    cp .env.example .env.local
#
# 키를 넣지 않아도 앱은 정상 동작합니다 (내장된 대사로 대신 답합니다).
# 단, 이 값은 브라우저에 그대로 노출되는 클라이언트 키이므로,
# 실제 서비스로 배포할 때는 서버(프록시)를 하나 두고 그쪽에서 Gemini를 호출하는 걸 권장합니다.

VITE_GEMINI_API_KEY=

# 사용할 모델 이름 (선택, 기본값은 gemini-3.6-flash)
VITE_GEMINI_MODEL=gemini-3.6-flash
